@media(max-width:700px){body{font-size:17px}.paises{grid-template-columns:1fr}.cuerpo{padding:22px 22px 24px}.lugar{font-size:18px}.contacto{font-size:17px}.fila p{font-size:17px}.cabeza{padding:52px 0 44px}.cabeza p.lead{font-size:18px}.zona{padding-top:44px}.zona-tit{flex-direction:column;gap:4px}.zona-tit h2{font-size:28px}.paises{grid-template-columns:1fr;gap:22px}.pais h3{font-size:25px}.fila h3{font-size:21px}}
